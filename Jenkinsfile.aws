pipeline {
    agent none

    options {
        // Two builds must never touch the same cluster or Terraform state at once. A waiting build queues, it is not aborted.
        disableConcurrentBuilds()
        // Safety net so a hung build cannot block the queue forever. The stage timeouts below are tighter.
        timeout(time: 180, unit: 'MINUTES')
        // Keep the last 20 builds so the Jenkins disk does not fill up.
        buildDiscarder(logRotator(numToKeepStr: '20'))
        // Prefix every console line with the time, so slow steps are easy to find.
        timestamps()
    }

    parameters {
        booleanParam(
            name: 'RUN_AWS',
            defaultValue: false,
            description: 'Run the stages that touch AWS (ECR, Terraform, EKS). Leave unchecked for a fully local run.'
        )
    }

    environment {
        AWS_REGION   = 'ap-south-1'
        CLUSTER_NAME = 'campuscart-eks'
        APP_NS       = 'campuscart'
        // EDIT ME: Jenkins user IDs or group names (comma separated) allowed to click Apply / Deploy.
        APPROVERS    = 'devops-approvers'
    }

    stages {

        stage('Checkout') {
            options { timeout(time: 10, unit: 'MINUTES') }
            agent {
                kubernetes {
                    yaml '''
apiVersion: v1
kind: Pod
spec:
  containers:
    - name: git
      image: alpine/git:v2.54.0
      command: ["cat"]
      tty: true
'''
                }
            }
            steps {
                container('git') {
                    script {
                        def scmVars = checkout scm
                        sh 'git config --global --add safe.directory "$(pwd)"'

                        // Works for multibranch (BRANCH_NAME) and for a plain Pipeline-from-SCM job (GIT_BRANCH).
                        def branch = env.BRANCH_NAME ?: (scmVars.GIT_BRANCH ?: '').replaceFirst('^origin/', '')
                        env.IS_MAIN = (branch == 'main') ? 'true' : 'false'
                        echo "branch '${branch}' -> IS_MAIN=${env.IS_MAIN} (only main may push, apply or deploy, and only with RUN_AWS)"

                        def head = sh(
                            script: 'git rev-parse HEAD | cut -c1-7',
                            returnStdout: true
                        ).trim()

                        def webTag = sh(
                            script: 'git log -1 --format=%H -- campuscart-backend | cut -c1-7',
                            returnStdout: true
                        ).trim() ?: head

                        def nginxTag = sh(
                            script: 'git log -1 --format=%H -- nginx frontend .dockerignore | cut -c1-7',
                            returnStdout: true
                        ).trim() ?: head

                        env.WEB_TAG = webTag
                        env.NGINX_TAG = nginxTag

                        // Without an ECR lookup we assume "not built yet", so Test and Scan always run.
                        env.WEB_EXISTS = 'false'
                        env.NGINX_EXISTS = 'false'
                    }
                }

                stash name: 'source', includes: '**'
            }
        }

        stage('Check ECR') {
            options { timeout(time: 5, unit: 'MINUTES') }
            when {
                beforeAgent true
                expression { params.RUN_AWS && env.IS_MAIN == 'true' }
            }
            agent {
                kubernetes {
                    yaml '''
apiVersion: v1
kind: Pod
spec:
  containers:
    - name: aws-cli
      image: amazon/aws-cli:2.17.0
      command: ["cat"]
      tty: true
'''
                }
            }
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-campuscart-ci'
                ]]) {
                    container('aws-cli') {
                        script {
                            def webStatus = sh(
                                script: '''
                                    aws ecr describe-images \
                                      --region "$AWS_REGION" \
                                      --repository-name campuscart-backend \
                                      --image-ids imageTag="$WEB_TAG" \
                                      >/dev/null 2>&1
                                ''',
                                returnStatus: true
                            )

                            def nginxStatus = sh(
                                script: '''
                                    aws ecr describe-images \
                                      --region "$AWS_REGION" \
                                      --repository-name campuscart-nginx \
                                      --image-ids imageTag="$NGINX_TAG" \
                                      >/dev/null 2>&1
                                ''',
                                returnStatus: true
                            )

                            env.WEB_EXISTS = webStatus == 0 ? 'true' : 'false'
                            env.NGINX_EXISTS = nginxStatus == 0 ? 'true' : 'false'

                            echo "Backend tag ${env.WEB_TAG} (already in ECR: ${env.WEB_EXISTS})"
                            echo "Nginx tag ${env.NGINX_TAG} (already in ECR: ${env.NGINX_EXISTS})"
                        }
                    }
                }
            }
        }

        stage('Test') {
            options { timeout(time: 30, unit: 'MINUTES') }
            when {
                beforeAgent true
                expression { env.WEB_EXISTS != 'true' || env.NGINX_EXISTS != 'true' }
            }
            agent {
                kubernetes {
                    yaml '''
apiVersion: v1
kind: Pod
spec:
  containers:
    - name: python
      image: python:3.12.16-slim
      command: ["cat"]
      tty: true
      resources:
        requests:
          cpu: "500m"
          memory: "512Mi"
        limits:
          cpu: "1"
          memory: "1Gi"
      env:
        - name: DB_HOST
          value: "localhost"
        - name: DB_PORT
          value: "5432"
        - name: DB_NAME
          value: "test_campuscart_db"
        - name: DB_USER
          value: "test_user"
        - name: DB_PASSWORD
          value: "test_pass"
        - name: REDIS_HOST
          value: "localhost"
        - name: REDIS_PORT
          value: "6379"
        - name: DJANGO_SECRET_KEY
          value: "ci-test-only-not-a-real-secret-00000000"
        - name: DEBUG
          value: "True"
        - name: ALLOWED_HOSTS
          value: "localhost,127.0.0.1"

    - name: postgres
      image: postgres:15.20-alpine
      env:
        - name: POSTGRES_DB
          value: "test_campuscart_db"
        - name: POSTGRES_USER
          value: "test_user"
        - name: POSTGRES_PASSWORD
          value: "test_pass"
      resources:
        requests:
          cpu: "250m"
          memory: "256Mi"

    - name: redis
      image: redis:7.4.12-alpine
      resources:
        requests:
          cpu: "100m"
          memory: "128Mi"
'''
                }
            }
            steps {
                container('python') {
                    unstash 'source'

                    retry(2) {
                        sh '''
                            apt-get update -qq
                            apt-get install -y -qq netcat-openbsd > /dev/null
                        '''
                    }

                    sh '''
                        until nc -z localhost 5432; do
                            echo "Waiting for Postgres..."
                            sleep 2
                        done

                        until nc -z localhost 6379; do
                            echo "Waiting for Redis..."
                            sleep 2
                        done

                        echo "Postgres and Redis are ready."
                    '''

                    retry(2) {
                        sh '''
                            export PIP_TIMEOUT=300 PIP_RETRIES=5
                            cd campuscart-backend
                            pip install --no-cache-dir -r requirements.txt
                        '''
                    }

                    sh '''
                        cd campuscart-backend
                        python manage.py test --noinput --verbosity=2
                    '''
                }
            }
        }

        stage('Security Scan') {
            options { timeout(time: 15, unit: 'MINUTES') }
            when {
                beforeAgent true
                expression { env.WEB_EXISTS != 'true' || env.NGINX_EXISTS != 'true' }
            }
            agent {
                kubernetes {
                    yaml '''
apiVersion: v1
kind: Pod
spec:
  containers:
    - name: python
      image: python:3.12.16-slim
      command: ["cat"]
      tty: true
      resources:
        requests:
          cpu: "100m"
          memory: "256Mi"
        limits:
          cpu: "500m"
          memory: "512Mi"
'''
                }
            }
            steps {
                container('python') {
                    unstash 'source'

                    retry(2) {
                        sh '''
                            export PIP_TIMEOUT=300 PIP_RETRIES=5
                            pip install --no-cache-dir -q pip-audit bandit

                            cd campuscart-backend

                            # Fail on MEDIUM severity and above.
                            bandit -r . -q -ll

                            # Fail on known vulnerabilities in pinned requirements (this call asks the network).
                            pip-audit --timeout 120 -r requirements.txt --no-deps --disable-pip
                        '''
                    }
                }
            }
        }

        stage('Terraform Plan') {
            options { timeout(time: 20, unit: 'MINUTES') }
            when {
                beforeAgent true
                expression { params.RUN_AWS && env.IS_MAIN == 'true' }
            }
            agent {
                kubernetes {
                    yaml '''
apiVersion: v1
kind: Pod
spec:
  containers:
    - name: terraform
      image: hashicorp/terraform:1.10.5
      command: ["cat"]
      tty: true
'''
                }
            }
            steps {
                container('terraform') {
                    unstash 'source'

                    withCredentials([[
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'aws-campuscart-ci'
                    ]]) {
                        dir('terraform/environments/production') {
                            retry(2) { sh 'terraform init -input=false' }
                            sh 'terraform plan -input=false -out=tfplan'
                            sh 'terraform show -no-color tfplan > tfplan.txt'
                        }
                    }

                    stash name: 'tfplan',
                        includes: 'terraform/environments/production/tfplan,terraform/environments/production/tfplan.txt'
                }
            }
        }

        stage('Show Terraform Plan') {
            options { timeout(time: 5, unit: 'MINUTES') }
            when {
                beforeAgent true
                expression { params.RUN_AWS && env.IS_MAIN == 'true' }
            }
            agent {
                kubernetes {
                    yaml '''
apiVersion: v1
kind: Pod
spec:
  containers:
    - name: git
      image: alpine/git:v2.54.0
      command: ["cat"]
      tty: true
'''
                }
            }
            steps {
                container('git') {
                    unstash 'tfplan'
                    sh 'cat terraform/environments/production/tfplan.txt'
                }
            }
        }

        stage('Approve Infrastructure Changes') {
            when {
                expression { params.RUN_AWS && env.IS_MAIN == 'true' }
            }
            agent none

            steps {
                timeout(time: 30, unit: 'MINUTES') {
                    input(
                        message: 'Review the plan in the Show Terraform Plan stage. Look for any destroy or replace of RDS, VPC, EKS or state. Apply these infrastructure changes to production?',
                        ok: 'Apply',
                        submitter: env.APPROVERS
                    )
                }
            }
        }

        stage('Terraform Apply') {
            options { timeout(time: 45, unit: 'MINUTES') }
            when {
                beforeAgent true
                expression { params.RUN_AWS && env.IS_MAIN == 'true' }
            }
            agent {
                kubernetes {
                    yaml '''
apiVersion: v1
kind: Pod
spec:
  containers:
    - name: terraform
      image: hashicorp/terraform:1.10.5
      command: ["cat"]
      tty: true
'''
                }
            }
            steps {
                container('terraform') {
                    unstash 'tfplan'

                    withCredentials([[
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'aws-campuscart-ci'
                    ]]) {
                        dir('terraform/environments/production') {
                            retry(2) { sh 'terraform init -input=false' }
                            sh 'terraform apply -input=false tfplan'
                        }
                    }
                }
            }
        }

        stage('Prepare AWS Context') {
            options { timeout(time: 5, unit: 'MINUTES') }
            when {
                beforeAgent true
                expression { params.RUN_AWS && env.IS_MAIN == 'true' }
            }
            agent {
                kubernetes {
                    yaml '''
apiVersion: v1
kind: Pod
spec:
  containers:
    - name: aws-cli
      image: amazon/aws-cli:2.17.0
      command: ["cat"]
      tty: true
'''
                }
            }
            steps {
                container('aws-cli') {
                    withCredentials([[
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'aws-campuscart-ci'
                    ]]) {
                        script {
                            retry(2) {
                                env.AWS_ACCOUNT_ID = sh(
                                    script: 'aws sts get-caller-identity --query Account --output text',
                                    returnStdout: true
                                ).trim()
                            }

                            env.ECR_REGISTRY =
                                "${env.AWS_ACCOUNT_ID}.dkr.ecr.${env.AWS_REGION}.amazonaws.com"
                        }
                    }
                }
            }
        }

        stage('Build and Push Images') {
            options { timeout(time: 30, unit: 'MINUTES') }
            when {
                beforeAgent true
                expression {
                    params.RUN_AWS && env.IS_MAIN == 'true' &&
                    (env.WEB_EXISTS != 'true' || env.NGINX_EXISTS != 'true')
                }
            }
            agent {
                kubernetes {
                    yaml '''
apiVersion: v1
kind: Pod
spec:
  containers:
    - name: kaniko-web
      image: gcr.io/kaniko-project/executor:v1.24.0-debug
      command: ["cat"]
      tty: true
      resources:
        requests:
          cpu: "500m"
          memory: "1Gi"
        limits:
          cpu: "2"
          memory: "2Gi"

    - name: kaniko-nginx
      image: gcr.io/kaniko-project/executor:v1.24.0-debug
      command: ["cat"]
      tty: true
      resources:
        requests:
          cpu: "250m"
          memory: "512Mi"
        limits:
          cpu: "1"
          memory: "1Gi"
'''
                }
            }
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-campuscart-ci'
                ]]) {
                    container('kaniko-web') {
                        unstash 'source'

                        sh '''
                            if [ "$WEB_EXISTS" = "true" ]; then
                                echo "Backend image ${WEB_TAG} already exists; skipping build."
                                exit 0
                            fi

                            /kaniko/executor \
                              --context=dir://$(pwd)/campuscart-backend \
                              --dockerfile=$(pwd)/campuscart-backend/Dockerfile \
                              --destination=${ECR_REGISTRY}/campuscart-backend:${WEB_TAG} \
                              --cache=true
                        '''
                    }

                    container('kaniko-nginx') {
                        unstash 'source'

                        sh '''
                            if [ "$NGINX_EXISTS" = "true" ]; then
                                echo "Nginx image ${NGINX_TAG} already exists; skipping build."
                                exit 0
                            fi

                            /kaniko/executor \
                              --context=dir://$(pwd) \
                              --dockerfile=$(pwd)/nginx/Dockerfile \
                              --destination=${ECR_REGISTRY}/campuscart-nginx:${NGINX_TAG} \
                              --cache=true
                        '''
                    }
                }
            }
        }

        stage('Read Terraform Outputs') {
            options { timeout(time: 10, unit: 'MINUTES') }
            when {
                beforeAgent true
                expression { params.RUN_AWS && env.IS_MAIN == 'true' }
            }
            agent {
                kubernetes {
                    yaml '''
apiVersion: v1
kind: Pod
spec:
  containers:
    - name: terraform
      image: hashicorp/terraform:1.10.5
      command: ["cat"]
      tty: true
'''
                }
            }
            steps {
                container('terraform') {
                    unstash 'source'

                    withCredentials([[
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'aws-campuscart-ci'
                    ]]) {
                        dir('terraform/environments/production') {
                            retry(2) { sh 'terraform init -input=false' }
                            retry(2) { sh 'terraform output -json > "$WORKSPACE/tf-outputs.json"' }
                        }
                    }

                    stash name: 'tf-outputs', includes: 'tf-outputs.json'
                }
            }
        }

        stage('Render Manifests') {
            options { timeout(time: 5, unit: 'MINUTES') }
            when {
                beforeAgent true
                expression { params.RUN_AWS && env.IS_MAIN == 'true' }
            }
            agent {
                kubernetes {
                    yaml '''
apiVersion: v1
kind: Pod
spec:
  containers:
    - name: tools
      image: alpine/k8s:1.31.13
      command: ["cat"]
      tty: true
'''
                }
            }
            steps {
                container('tools') {
                    unstash 'source'
                    unstash 'tf-outputs'

                    sh '''
                        RDS_ENDPOINT=$(jq -r '.db_endpoint.value' tf-outputs.json)
                        REDIS_ENDPOINT=$(jq -r '.redis_endpoint.value' tf-outputs.json)
                        ECR_BACKEND_IMAGE=$(jq -r '.ecr_repository_urls.value["campuscart-backend"]' tf-outputs.json)
                        ECR_NGINX_IMAGE=$(jq -r '.ecr_repository_urls.value["campuscart-nginx"]' tf-outputs.json)
                        export RDS_ENDPOINT REDIS_ENDPOINT ECR_BACKEND_IMAGE ECR_NGINX_IMAGE
                        sh scripts/ci/render-manifests.sh
                    '''

                    stash name: 'rendered-manifests', includes: 'rendered/**'
                }
            }
        }

        stage('Approve Production Deploy') {
            when {
                expression { params.RUN_AWS && env.IS_MAIN == 'true' }
            }
            agent none

            steps {
                timeout(time: 30, unit: 'MINUTES') {
                    input(
                        message: "Deploy backend ${env.WEB_TAG} and nginx ${env.NGINX_TAG} to ${env.CLUSTER_NAME} (namespace ${env.APP_NS})? The migration Job runs first. Database migrations are NOT rolled back automatically.",
                        ok: 'Deploy',
                        submitter: env.APPROVERS
                    )
                }
            }
        }

        stage('Deploy to EKS') {
            options { timeout(time: 25, unit: 'MINUTES') }
            when {
                beforeAgent true
                expression { params.RUN_AWS && env.IS_MAIN == 'true' }
            }
            agent {
                kubernetes {
                    yaml '''
apiVersion: v1
kind: Pod
spec:
  containers:
    - name: kubectl
      image: alpine/k8s:1.31.13
      command: ["cat"]
      tty: true
'''
                }
            }
            steps {
                container('kubectl') {
                    unstash 'source'
                    unstash 'rendered-manifests'

                    withCredentials([[
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'aws-campuscart-ci'
                    ]]) {
                        retry(2) {
                            sh '''
                                aws eks update-kubeconfig \
                                  --name "$CLUSTER_NAME" \
                                  --region "$AWS_REGION"
                            '''
                        }

                        // 1. Namespace, config and secret plumbing. The migration Job needs the DB Secret to exist.
                        sh '''
                            kubectl apply -f rendered/namespace.yaml
                            kubectl apply -f rendered/configmap.yaml
                            kubectl apply -f rendered/nginx-configmap.yaml
                            kubectl apply -f rendered/serviceaccount.yaml
                            kubectl apply -f rendered/secretstore.yaml
                            kubectl apply -f rendered/externalsecret.yaml
                            kubectl wait --for=condition=Ready externalsecret/campuscart-db-secret \
                              -n "$APP_NS" --timeout=180s
                            kubectl apply -f rendered/backend-service.yaml
                            kubectl apply -f rendered/nginx-service.yaml
                            kubectl apply -f rendered/ingress.yaml
                        '''

                        // 2. Remember what is running NOW, before this build changes anything.
                        //    post { failure } only restores Deployments whose revision moved past these numbers.
                        script {
                            env.WEB_REV_BEFORE = sh(
                                script: 'sh scripts/ci/rollback.sh revision "$APP_NS" campuscart-backend',
                                returnStdout: true
                            ).trim()
                            env.NGINX_REV_BEFORE = sh(
                                script: 'sh scripts/ci/rollback.sh revision "$APP_NS" campuscart-nginx',
                                returnStdout: true
                            ).trim()
                            env.ROLLBACK_ARMED = 'true'
                            echo "Revisions before deploy: backend=${env.WEB_REV_BEFORE ?: 'none'} nginx=${env.NGINX_REV_BEFORE ?: 'none'}"
                        }

                        // 3. Database migration FIRST. If it fails, the deploy stops here and no Deployment is touched.
                        sh '''
                            kubectl delete job campuscart-migrate -n "$APP_NS" --ignore-not-found
                            kubectl apply -f rendered/migrate-job.yaml
                            sh scripts/ci/wait-for-job.sh "$APP_NS" campuscart-migrate 300
                        '''

                        // 4. New Deployments, then wait for them.
                        sh '''
                            kubectl apply -f rendered/backend-deployment.yaml
                            kubectl apply -f rendered/nginx-deployment.yaml
                            kubectl apply -f rendered/hpa.yaml
                        '''

                        sh '''
                            kubectl rollout status deployment/campuscart-backend \
                              -n "$APP_NS" \
                              --timeout=300s

                            kubectl rollout status deployment/campuscart-nginx \
                              -n "$APP_NS" \
                              --timeout=120s
                        '''
                    }
                }
            }
        }
    }

    post {
        success {
            echo "Build #${env.BUILD_NUMBER} OK (RUN_AWS=${params.RUN_AWS}, branch main: ${env.IS_MAIN}), backend ${env.WEB_TAG}, nginx ${env.NGINX_TAG}."
        }

        failure {
            echo "CampusCart AWS build #${env.BUILD_NUMBER} FAILED: ${env.BUILD_URL}"

            script {
                try {
                    timeout(time: 15, unit: 'MINUTES') {
                        podTemplate(yaml: '''
apiVersion: v1
kind: Pod
spec:
  containers:
    - name: tools
      image: alpine/k8s:1.31.13
      command: ["cat"]
      tty: true
      resources:
        requests:
          cpu: "100m"
          memory: "128Mi"
        limits:
          cpu: "500m"
          memory: "256Mi"
''') {
                            node(POD_LABEL) {
                                container('tools') {
                                    // Roll back first, then notify. A failed rollback must still reach the notification.
                                    if (env.ROLLBACK_ARMED == 'true') {
                                        try {
                                            unstash 'source'
                                            withCredentials([[
                                                $class: 'AmazonWebServicesCredentialsBinding',
                                                credentialsId: 'aws-campuscart-ci'
                                            ]]) {
                                                sh '''
                                                    aws eks update-kubeconfig \
                                                      --name "$CLUSTER_NAME" \
                                                      --region "$AWS_REGION"

                                                    sh scripts/ci/rollback.sh undo "$APP_NS" \
                                                      "campuscart-backend:${WEB_REV_BEFORE}" \
                                                      "campuscart-nginx:${NGINX_REV_BEFORE}"
                                                '''
                                            }
                                        } catch (rbErr) {
                                            echo "ROLLBACK FAILED, fix the cluster by hand: ${rbErr.message}"
                                        }
                                    }

                                    withCredentials([
                                        string(
                                            credentialsId: 'notify-webhook',
                                            variable: 'HOOK'
                                        )
                                    ]) {
                                        sh '''
                                            MSG="CampusCart AWS build #${BUILD_NUMBER} FAILED: ${BUILD_URL}"
                                            printf '{"text":"%s"}' "$MSG" > /tmp/payload.json
                                            curl -fsS -X POST \
                                              -H 'Content-Type: application/json' \
                                              --data @/tmp/payload.json \
                                              "$HOOK"
                                        '''
                                    }
                                }
                            }
                        }
                    }
                } catch (err) {
                    echo "Failure handling skipped: ${err.message}"
                }
            }
        }
    }
}
