// //                     ]]) {
// //                         dir('terraform/environments/production') {
// //                             sh 'terraform init -input=false'
// //                             script {
// //                                 // Pulling REAL, freshly-applied values straight
// //                                 // out of Terraform state — never hand-typed,
// //                                 // never stale. This is the actual bridge
// //                                 // between "infrastructure as code" and "app
// //                                 // deployment" — Terraform's own outputs become
// //                                 // this pipeline's environment variables.
// //                                 env.RDS_ENDPOINT       = sh(script: 'terraform output -raw db_endpoint', returnStdout: true).trim()
// //                                 env.REDIS_ENDPOINT     = sh(script: 'terraform output -raw redis_endpoint', returnStdout: true).trim()
