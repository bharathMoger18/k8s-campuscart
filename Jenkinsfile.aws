// =============================================================================
// Jenkinsfile.aws
// =============================================================================
pipeline {
    agent none

    environment {
        AWS_REGION   = 'ap-south-1'
        CLUSTER_NAME = 'campuscart-eks'
    }

    stages {

        stage('Checkout') {
            agent {
                kubernetes {
                    yaml '''
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: git
    image: alpine/git:latest
    command: ["cat"]
    tty: true
'''
                }
            }
            steps {
                container('git') {
                    checkout scm
                    script {
                        sh 'git config --global --add safe.directory "$(pwd)"'
                        env.IMAGE_TAG = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
                    }
                    stash name: 'source', includes: '**'
                }
            }
        }

        stage('Test') {
            agent {
                kubernetes {
                    yaml '''
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: python
    image: python:3.12-slim
    command: ["cat"]
    tty: true
    resources:
      requests:
        cpu: "500m"
        memory: "512Mi"
      limits:
        cpu: "1"
        memory: "1Gi"
    env:
      - name: DB_HOST
        value: "localhost"
      - name: DB_PORT
        value: "5432"
      - name: DB_NAME
        value: "test_campuscart_db"
      - name: DB_USER
        value: "test_user"
      - name: DB_PASSWORD
        value: "test_pass"
      - name: REDIS_HOST
        value: "localhost"
      - name: REDIS_PORT
        value: "6379"
      - name: DJANGO_SECRET_KEY
        value: "ci-test-only-not-a-real-secret"
      - name: DEBUG
        value: "True"
      - name: ALLOWED_HOSTS
        value: "localhost,127.0.0.1"
  - name: postgres
    image: postgres:15-alpine
    env:
      - name: POSTGRES_DB
        value: "test_campuscart_db"
      - name: POSTGRES_USER
        value: "test_user"
      - name: POSTGRES_PASSWORD
        value: "test_pass"
    resources:
      requests:
        cpu: "250m"
        memory: "256Mi"
  - name: redis
    image: redis:7-alpine
    resources:
      requests:
        cpu: "100m"
        memory: "128Mi"
'''
                }
            }
            steps {
                container('python') {
                    unstash 'source'
                    sh '''
                        apt-get update -qq && apt-get install -y -qq netcat-openbsd > /dev/null
                        until nc -z localhost 5432; do echo "Waiting for Postgres..."; sleep 2; done
                        until nc -z localhost 6379; do echo "Waiting for Redis..."; sleep 2; done
                        echo "Postgres and Redis are ready."
                    '''
                    sh '''
                        cd campuscart-backend
                        pip install --no-cache-dir -r requirements.txt
                    '''
                    sh '''
                        cd campuscart-backend
                        python manage.py test --verbosity=2
                    '''
                }
            }
        }

        // ---------------------------------------------------------------
        // MOVED: Terraform now runs BEFORE image build/push. This
        // guarantees ECR repositories (and everything else images/deploy
        // depend on) actually exist before anything tries to use them.
        // ---------------------------------------------------------------
        stage('Terraform Plan') {
            agent {
                kubernetes {
                    yaml '''
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: terraform
    image: hashicorp/terraform:1.10.5
    command: ["cat"]
    tty: true
'''
                }
            }
            steps {
                container('terraform') {
                    unstash 'source'
                    withCredentials([[
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'aws-campuscart-ci'
                    ]]) {
                        dir('terraform/environments/production') {
                            sh 'terraform init -input=false'
                            sh 'terraform plan -input=false -out=tfplan'
                            sh 'terraform show -no-color tfplan > tfplan.txt'
                        }
                    }
                    stash name: 'tfplan', includes: 'terraform/environments/production/tfplan,terraform/environments/production/tfplan.txt'
                }
            }
        }

        stage('Approve Infrastructure Changes') {
            agent none
            steps {
                script {
                    unstash 'tfplan'
                    sh 'cat terraform/environments/production/tfplan.txt'
                }
                timeout(time: 30, unit: 'MINUTES') {
                    input(
                        message: 'Review the Terraform plan above. Apply these infrastructure changes?',
                        submitter: 'bharath'
                    )
                }
            }
        }

        stage('Terraform Apply') {
            agent {
                kubernetes {
                    yaml '''
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: terraform
    image: hashicorp/terraform:1.10.5
    command: ["cat"]
    tty: true
'''
                }
            }
            steps {
                container('terraform') {
                    unstash 'tfplan'
                    withCredentials([[
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'aws-campuscart-ci'
                    ]]) {
                        dir('terraform/environments/production') {
                            sh 'terraform init -input=false'
                            sh 'terraform apply -input=false tfplan'
                        }
                    }
                }
            }
        }

        stage('Prepare AWS Context') {
            agent {
                kubernetes {
                    yaml '''
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: aws-cli
    image: amazon/aws-cli:2.17.0
    command: ["cat"]
    tty: true
'''
                }
            }
            steps {
                container('aws-cli') {
                    withCredentials([[
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'aws-campuscart-ci'
                    ]]) {
                        script {
                            env.AWS_ACCOUNT_ID = sh(
                                script: "aws sts get-caller-identity --query Account --output text",
                                returnStdout: true
                            ).trim()
                            env.ECR_REGISTRY = "${env.AWS_ACCOUNT_ID}.dkr.ecr.${env.AWS_REGION}.amazonaws.com"
                        }
                    }
                }
            }
        }

        stage('Build and Push Images') {
            agent {
                kubernetes {
                    yaml '''
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: kaniko-web
    image: gcr.io/kaniko-project/executor:debug
    command: ["cat"]
    tty: true
    resources:
      requests:
        cpu: "500m"
        memory: "1Gi"
      limits:
        cpu: "2"
        memory: "2Gi"
  - name: kaniko-nginx
    image: gcr.io/kaniko-project/executor:debug
    command: ["cat"]
    tty: true
    resources:
      requests:
        cpu: "250m"
        memory: "512Mi"
      limits:
        cpu: "1"
        memory: "1Gi"
'''
                }
            }
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-campuscart-ci'
                ]]) {
                    container('kaniko-web') {
                        unstash 'source'
                        sh '''
                            /kaniko/executor \
                              --context=dir://$(pwd)/campuscart-backend \
                              --dockerfile=$(pwd)/campuscart-backend/Dockerfile \
                              --destination=${ECR_REGISTRY}/campuscart-backend:${IMAGE_TAG} \
                              --cache=true
                        '''
                    }
                    container('kaniko-nginx') {
                        unstash 'source'
                        sh '''
                            /kaniko/executor \
                              --context=dir://$(pwd) \
                              --dockerfile=$(pwd)/nginx/Dockerfile \
                              --destination=${ECR_REGISTRY}/campuscart-nginx:${IMAGE_TAG} \
                              --cache=true
                        '''
                    }
                }
            }
        }

        stage('Render Manifests') {
            agent {
                kubernetes {
                    yaml '''
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: terraform
    image: hashicorp/terraform:1.10.5
    command: ["cat"]
    tty: true
'''
                }
            }
            steps {
                container('terraform') {
                    unstash 'source'
                    withCredentials([[
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'aws-campuscart-ci'
                    ]]) {
                        dir('terraform/environments/production') {
                            sh 'terraform init -input=false'
                            script {
                                env.RDS_ENDPOINT      = sh(script: 'terraform output -raw db_endpoint', returnStdout: true).trim()
                                env.REDIS_ENDPOINT    = sh(script: 'terraform output -raw redis_endpoint', returnStdout: true).trim()
                                env.ECR_BACKEND_IMAGE = sh(script: "terraform output -json ecr_repository_urls | jq -r '.\"campuscart-backend\"'", returnStdout: true).trim()
                                env.ECR_NGINX_IMAGE   = sh(script: "terraform output -json ecr_repository_urls | jq -r '.\"campuscart-nginx\"'", returnStdout: true).trim()
                            }
                        }
                    }
                    sh '''
                        mkdir -p rendered
                        for f in k8s-aws/*.yaml; do
                          envsubst '${RDS_ENDPOINT} ${REDIS_ENDPOINT} ${ECR_BACKEND_IMAGE} ${ECR_NGINX_IMAGE} ${IMAGE_TAG}' \
                            < "$f" > "rendered/$(basename "$f")"
                        done
                    '''
                    stash name: 'rendered-manifests', includes: 'rendered/**'
                }
            }
        }

        stage('Deploy to EKS') {
            agent {
                kubernetes {
                    yaml '''
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: kubectl
    image: amazon/aws-cli:2.17.0
    command: ["cat"]
    tty: true
'''
                }
            }
            steps {
                container('kubectl') {
                    unstash 'rendered-manifests'
                    withCredentials([[
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'aws-campuscart-ci'
                    ]]) {
                        sh '''
                            aws eks update-kubeconfig --name campuscart-eks --region ${AWS_REGION}
                        '''
                        sh '''
                            kubectl apply -f rendered/namespace.yaml
                            kubectl apply -f rendered/configmap.yaml
                            kubectl apply -f rendered/serviceaccount.yaml
                            kubectl apply -f rendered/secretstore.yaml
                            kubectl apply -f rendered/externalsecret.yaml
                            kubectl apply -f rendered/backend-deployment.yaml
                            kubectl apply -f rendered/backend-service.yaml
                            kubectl apply -f rendered/nginx-deployment.yaml
                            kubectl apply -f rendered/nginx-service.yaml
                            kubectl apply -f rendered/ingress.yaml
                            kubectl apply -f rendered/hpa.yaml
                        '''
                        sh '''
                            kubectl rollout status deployment/campuscart-backend -n campuscart --timeout=180s
                            kubectl rollout status deployment/campuscart-nginx -n campuscart --timeout=120s
                        '''
                    }
                }
            }
        }
    }

    post {
        success {
            echo "Deployed ${env.IMAGE_TAG} to EKS successfully."
        }
        failure {
            echo "Pipeline failed — check the stage logs above. Infrastructure changes, if any were applied, are NOT automatically rolled back."
        }
    }
}