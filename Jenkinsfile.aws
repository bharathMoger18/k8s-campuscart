// //                             }
// //                         }
// //                     }
// //                     // envsubst is only given an EXPLICIT list of variable
// //                     // names to replace — NOT every ${...} pattern blindly.
// //                     // Why this matters: some of our YAML/config could
// //                     // theoretically contain a literal $ character that was
// //                     // never meant to be substituted (rare, but a real
