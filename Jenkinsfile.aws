// //                             # access entry is what makes AWS accept that identity
// //                             # for KUBERNETES-level operations, not just AWS APIs.
// //                             aws eks update-kubeconfig --name campuscart-eks --region ${AWS_REGION}
// //                         '''

// //                         // ORDER MATTERS here, and it's not arbitrary — the
// //                         // namespace must exist before anything can be
// //                         // deployed INTO it; the ConfigMap/Secret should exist
// //                         // before Deployments that reference them start, or
// //                         // pods would crash-loop on missing env vars at
// //                         // startup. kubectl apply doesn't guarantee any
// //                         // ordering across multiple files on its own — WE
// //                         // enforce it explicitly here.
// //                         sh '''
// //                             kubectl apply -f rendered/namespace.yaml
// //                             kubectl apply -f rendered/configmap.yaml
// //                             kubectl apply -f rendered/serviceaccount.yaml
// //                             kubectl apply -f rendered/secretstore.yaml
// //                             kubectl apply -f rendered/externalsecret.yaml
// //                             kubectl apply -f rendered/backend-deployment.yaml
// //                             kubectl apply -f rendered/backend-service.yaml
// //                             kubectl apply -f rendered/nginx-deployment.yaml
// //                             kubectl apply -f rendered/nginx-service.yaml
// //                             kubectl apply -f rendered/ingress.yaml
// //                             kubectl apply -f rendered/hpa.yaml
// //                         '''

// //                         // BLOCKS until the new pods are actually Ready, same
// //                         // principle as your existing pipeline's rollout
// //                         // status check — turns "I told Kubernetes to update"
// //                         // into a genuine pass/fail signal the pipeline can
// //                         // act on, not fire-and-forget.
// //                         sh '''
// //                             kubectl rollout status deployment/campuscart-backend -n campuscart --timeout=180s
// //                             kubectl rollout status deployment/campuscart-nginx -n campuscart --timeout=120s
// //                         '''
// //                     }
// //                 }
// //             }
// //         }
// //     }

// //     // -------------------------------------------------------------------
// //     // post{} runs REGARDLESS of which stage succeeded or failed — the
// //     // pipeline's "finally" block, same concept as try/finally in most
// //     // programming languages.
// //     // -------------------------------------------------------------------
// //     post {
// //     success {
// //         echo "Deployed ${env.IMAGE_TAG} to EKS successfully."
// //     }
// //     failure {
// //         echo "Pipeline failed — check the stage logs above. Infrastructure changes, if any were applied, are NOT automatically rolled back."
// //     }
// // }
// // }



// // =============================================================================
// // Jenkinsfile.aws
// // =============================================================================
// // Separate from Jenkinsfile (which deploys to the self-managed kubeadm
// // cluster). This pipeline deploys the SAME application to AWS — building
// // images, pushing to ECR, provisioning/updating infra via Terraform, and
// // deploying to EKS.
// // =============================================================================

// pipeline {
//     // agent none: every stage below provisions its OWN ephemeral Kubernetes
//     // pod, tailored to that stage's specific tools. Nothing persists between
