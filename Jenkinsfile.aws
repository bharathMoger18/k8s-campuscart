// // // // =============================================================================
// // // // Jenkinsfile.aws
// // // // =============================================================================
// // // // Separate from your existing Jenkinsfile (which still deploys to your
// // // // self-managed kubeadm cluster). This pipeline deploys the SAME
// // // // application to AWS/EKS — different infra target, same source code.
// // // // =============================================================================

// // // pipeline {
// // //     // ---------------------------------------------------------------------
// // //     // `agent` tells Jenkins WHERE this pipeline's steps actually execute —
// // //     // which machine, which environment. `agent any` means "run on
// // //     // whichever available Jenkins agent has capacity" — the simplest
// // //     // option. In a larger real setup, you'd often see `agent { label
// // //     // 'docker' }` to target agents with specific tools pre-installed
// // //     // (docker, aws-cli, kubectl, terraform). We're keeping this simple
// // //     // for now and assuming a single capable agent.
// // //     // ---------------------------------------------------------------------
// // //     agent any

// // //     // ---------------------------------------------------------------------
// // //     // ENVIRONMENT VARIABLES — available to every stage below. Notice: NO
// // //     // secrets live here directly, even though this LOOKS like the natural
// // //     // place to put an AWS access key. Real secrets are injected via
// // //     // Jenkins CREDENTIALS BINDING inside individual stages instead —
// // //     // covered properly when we reach the ECR push stage.
// // //     // ---------------------------------------------------------------------
// // //     environment {
// // //         AWS_REGION       = 'ap-south-1'
// // //         ECR_REGISTRY     = "REPLACED_AT_RUNTIME" // populated dynamically once we fetch it from Terraform output, in a later stage
// // //         CLUSTER_NAME     = 'campuscart-eks'
// // //         IMAGE_TAG        = "${env.BUILD_NUMBER}" // Jenkins auto-provides BUILD_NUMBER — a unique, incrementing integer per pipeline run. Using this AS the image tag is a genuinely important decision, explained below.
// // //     }

// // //     stages {
// // //         // -------------------------------------------------------------------
// // //         // STAGE 1: Checkout
// // //         // -------------------------------------------------------------------
// // //         stage('Checkout') {
// // //             steps {
// // //                 // `checkout scm` pulls whatever revision triggered this
// // //                 // pipeline run — the exact commit, not just "the latest
// // //                 // main branch" — which matters because between when a
// // //                 // webhook fires and when this stage actually runs, someone
// // //                 // could theoretically push again. `checkout scm` guarantees
// // //                 // you're building exactly what triggered this run, nothing
// // //                 // newer, nothing older.
// // //                 checkout scm
// // //             }
// // //         }
// // //     }
// // // }


// // pipeline {
// //     agent none

// //     stages {

// //         stage('Checkout') {
// //             agent {
// //                 kubernetes {
// //                     yaml '''
// // apiVersion: v1
// // kind: Pod
// // spec:
// //   containers:
// //   - name: git
// //     image: alpine/git:latest
// //     command: ["cat"]
// //     tty: true
// // '''
// //                 }
// //             }
// //             steps {
// //                 container('git') {
// //                     checkout scm
// //                     script {
// //                         sh 'git config --global --add safe.directory "$(pwd)"'
// //                         // MATCHING your existing convention — short commit
// //                         // SHA, not a build number. Same reasoning as your
// //                         // original file: this identifies the CODE, not
// //                         // just "the Nth pipeline run."
// //                         env.IMAGE_TAG = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
// //                     }
// //                     stash name: 'source', includes: '**'
// //                 }
// //             }
// //         }

// //         // ---------------------------------------------------------------
// //         // TEST — genuinely almost IDENTICAL to your existing stage. This
// //         // is worth pointing out explicitly: your tests don't know or care
// //         // whether the eventual deployment target is kubeadm or EKS. Tests
// //         // validate YOUR APPLICATION CODE, completely independent of
// //         // infrastructure. This is exactly why it's smart to run the SAME
// //         // test stage regardless of deployment target — duplicating test
// //         // logic per environment would be pure waste and a place for the
// //         // two pipelines to silently drift out of sync.
// //         // ---------------------------------------------------------------
// //         stage('Test') {
// //             agent {
// //                 kubernetes {
// //                     yaml '''
// // apiVersion: v1
// // kind: Pod
// // spec:
// //   containers:
// //   - name: python
// //     image: python:3.12-slim
// //     command: ["cat"]
// //     tty: true
// //     resources:
// //       requests:
// //         cpu: "500m"
// //         memory: "512Mi"
// //       limits:
// //         cpu: "1"
// //         memory: "1Gi"
// //     env:
// //       - name: DB_HOST
// //         value: "localhost"
// //       - name: DB_PORT
// //         value: "5432"
// //       - name: DB_NAME
// //         value: "test_campuscart_db"
// //       - name: DB_USER
// //         value: "test_user"
// //       - name: DB_PASSWORD
// //         value: "test_pass"
// //       - name: REDIS_HOST
// //         value: "localhost"
// //       - name: REDIS_PORT
// //         value: "6379"
// //       - name: DJANGO_SECRET_KEY
