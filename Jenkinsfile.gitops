// Jenkinsfile.gitops: CI only. Builds and verifies images, then records the new
// image tags in the config repo. Argo CD does the deploying (it watches that repo).
pipeline {
    agent none

    parameters {
        // No branch parameter on purpose: every run starts from the current main of campuscart-config,
        // pushes a fresh promote-<web>-<nginx> branch and prints a pull request link. Production only
        // changes when you merge that pull request.
        // Validation mode: run Test, Security Scan and the image builds even when both images
        // already exist in the registry. Images that already exist are built WITHOUT pushing,
        // so nothing in the registry changes and tags stay immutable.
        booleanParam(name: 'FORCE_BUILD', defaultValue: false, description: 'Run Test, Security Scan and a no-push image build even if the images already exist (pipeline validation)')
    }

    options {
        // One build at a time: two builds must never race on the config repo.
        disableConcurrentBuilds()
        // Safety net so a hung build cannot block the queue forever.
        timeout(time: 60, unit: 'MINUTES')
    }

    environment {
        FORCE_BUILD = "${params.FORCE_BUILD}"
    }

    stages {

        stage('Checkout') {
            agent {
                kubernetes {
                    yaml '''
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: git
    image: alpine/git:v2.54.0
    command: ["cat"]
    tty: true
'''
                }
            }
            steps {
                container('git') {
                    dir('app-source') {
                        deleteDir()
                        sh 'git init'
                        sh 'git config --global --add safe.directory "$(pwd)"'
                        sh 'git remote add origin https://github.com/bharathMoger18/k8s-campuscart.git'
                        sh 'git fetch origin main'
                        sh 'git checkout -f FETCH_HEAD'

                        script {
                            def head     = sh(script: 'git rev-parse HEAD | cut -c1-7', returnStdout: true).trim()
                            def webTag   = sh(script: 'git log -1 --format=%H -- campuscart-backend | cut -c1-7', returnStdout: true).trim() ?: head
                            def nginxTag = sh(script: 'git log -1 --format=%H -- nginx frontend .dockerignore | cut -c1-7', returnStdout: true).trim() ?: head

                            def accept = 'application/vnd.docker.distribution.manifest.v2+json,application/vnd.oci.image.manifest.v1+json,application/vnd.oci.image.index.v1+json'
                            def webExists   = sh(script: "wget -q --spider --header='Accept: ${accept}' http://192.168.1.3:5000/v2/campuscart-web/manifests/${webTag}", returnStatus: true) == 0
                            def nginxExists = sh(script: "wget -q --spider --header='Accept: ${accept}' http://192.168.1.3:5000/v2/campuscart-nginx/manifests/${nginxTag}", returnStatus: true) == 0

                            env.WEB_TAG      = webTag
                            env.NGINX_TAG    = nginxTag
                            env.WEB_EXISTS   = webExists ? 'true' : 'false'
                            env.NGINX_EXISTS = nginxExists ? 'true' : 'false'

                            // Which stages will run. FORCE_BUILD turns the checks and builds on even for existing images.
                            env.RUN_CHECKS = (params.FORCE_BUILD || !webExists) ? 'true' : 'false'
                            env.RUN_BUILD  = (params.FORCE_BUILD || !webExists || !nginxExists) ? 'true' : 'false'

                            // Does production (main of the config repo) already run these tags? If yes there is
                            // nothing to scan and nothing to promote. Read-only use of the same SSH key.
                            def promoted = false
                            withCredentials([sshUserPrivateKey(credentialsId: 'config-repo-write-key', keyFileVariable: 'SSH_KEY')]) {
                                def mainTags = sh(returnStdout: true, script: '''
                                    export GIT_SSH_COMMAND="ssh -i ${SSH_KEY} -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=/tmp/known_hosts"
                                    rm -rf /tmp/config-check
                                    git clone --quiet --depth 1 --branch main git@github.com:bharathMoger18/campuscart-config.git /tmp/config-check
                                    F=/tmp/config-check/overlays/production/kustomization.yaml
                                    web=$(grep -A1 "campuscart-web" ${F} | grep newTag | awk '{print $2}')
                                    nginx=$(grep -A1 "campuscart-nginx" ${F} | grep newTag | awk '{print $2}')
                                    echo "${web} ${nginx}"
                                ''').trim()
                                echo "config repo main currently runs: ${mainTags}"
                                promoted = (mainTags == (webTag + ' ' + nginxTag))
                            }
                            env.NEEDS_PROMOTION = promoted ? 'false' : 'true'
                            env.RUN_IMAGE_SCAN  = (params.FORCE_BUILD || !promoted) ? 'true' : 'false'

                            echo "MAIN source HEAD ${head}; web tag ${webTag} (already in registry: ${webExists}); nginx tag ${nginxTag} (already in registry: ${nginxExists})"
                            echo "Plan: Test + Security Scan = ${env.RUN_CHECKS}; Build = ${env.RUN_BUILD}; Image Scan = ${env.RUN_IMAGE_SCAN}; Promote = ${env.NEEDS_PROMOTION}; FORCE_BUILD = ${params.FORCE_BUILD}"
                        }

                    }
                    stash name: 'source', includes: 'app-source/**', excludes: 'app-source/.git/**'
                }
            }
        }

        stage('Test') {
            when {
                beforeAgent true
                expression { env.RUN_CHECKS == 'true' }
            }
            agent {
                kubernetes {
                    yaml '''
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: python
    image: python:3.12.16-slim
    command: ["cat"]
    tty: true
    resources:
      requests:
        cpu: "500m"
        memory: "512Mi"
      limits:
        cpu: "1"
        memory: "1Gi"
    env:
      - name: DB_HOST
        value: "localhost"
      - name: DB_PORT
        value: "5432"
      - name: DB_NAME
        value: "test_campuscart_db"
      - name: DB_USER
        value: "test_user"
      - name: DB_PASSWORD
        value: "test_pass"
      - name: REDIS_HOST
        value: "localhost"
      - name: REDIS_PORT
        value: "6379"
      - name: DJANGO_SECRET_KEY
        value: "ci-test-only-not-a-real-secret-00000000"
      - name: DEBUG
        value: "True"
      - name: ALLOWED_HOSTS
        value: "localhost,127.0.0.1"

  - name: postgres
    image: postgres:15.20-alpine
    env:
      - name: POSTGRES_DB
        value: "test_campuscart_db"
      - name: POSTGRES_USER
        value: "test_user"
      - name: POSTGRES_PASSWORD
        value: "test_pass"
    resources:
      requests:
        cpu: "250m"
        memory: "256Mi"

  - name: redis
    image: redis:7.4.12-alpine
    resources:
      requests:
        cpu: "100m"
        memory: "128Mi"
'''
                }
            }
            steps {
                container('python') {
                    unstash 'source'
                    sh '''
                        apt-get update -qq && apt-get install -y -qq netcat-openbsd > /dev/null
                        until nc -z localhost 5432; do echo "Waiting for Postgres..."; sleep 2; done
                        until nc -z localhost 6379; do echo "Waiting for Redis..."; sleep 2; done
                        echo "Postgres and Redis are ready."
                    '''

                    sh '''
                        cd app-source/campuscart-backend
                        export PIP_TIMEOUT=1200
                        export PIP_RETRIES=5
                        pip install --no-cache-dir -r requirements.txt
                    '''

                    sh '''
                        cd app-source/campuscart-backend
                        python manage.py test --noinput --verbosity=2
                    '''
                }
            }
        }

        stage('Security Scan') {
            when {
                beforeAgent true
                expression { env.RUN_CHECKS == 'true' }
            }
            agent {
                kubernetes {
                    yaml '''
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: python
    image: python:3.12.16-slim
    command: ["cat"]
    tty: true
    resources:
      requests:
        cpu: "100m"
        memory: "256Mi"
      limits:
        cpu: "500m"
        memory: "512Mi"
'''
                }
            }
            steps {
                container('python') {
                    unstash 'source'
                    sh '''
                        pip install --no-cache-dir -q pip-audit==2.10.1 bandit==1.9.4
                        cd app-source/campuscart-backend
                        bandit -r . -q -ll
                        pip-audit --timeout 120 -r requirements.txt --no-deps --disable-pip
                    '''
                }
            }
        }

        stage('Build and Push Images') {
            when {
                beforeAgent true
                expression { env.RUN_BUILD == 'true' }
            }
            agent {
                kubernetes {
                    yaml '''
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: kaniko-web
    image: gcr.io/kaniko-project/executor:debug
    command: ["cat"]
    tty: true
    resources:
      requests:
        cpu: "500m"
        memory: "1Gi"
      limits:
        cpu: "2"
        memory: "2Gi"
  - name: kaniko-nginx
    image: gcr.io/kaniko-project/executor:debug
    command: ["cat"]
    tty: true
    resources:
      requests:
        cpu: "250m"
        memory: "512Mi"
      limits:
        cpu: "1"
        memory: "1Gi"
'''
                }
            }
            steps {
                container('kaniko-web') {
                    unstash 'source'
                    sh '''
                        PUSH_FLAGS=""
                        CACHE_FLAG="--cache=true"
                        if [ "${WEB_EXISTS}" = "true" ]; then
                            if [ "${FORCE_BUILD}" = "true" ]; then
                                echo "FORCE_BUILD: building web ${WEB_TAG} WITHOUT pushing (the tag already exists in the registry)"
                                PUSH_FLAGS="--no-push"
                                CACHE_FLAG="--cache=false"
                            else
                                echo "web image ${WEB_TAG} is already in the registry, skipping its build"
                                exit 0
                            fi
                        fi
                        /kaniko/executor \
                          --context=dir://$(pwd)/app-source/campuscart-backend \
                          --dockerfile=$(pwd)/app-source/campuscart-backend/Dockerfile \
                          --destination=192.168.1.3:5000/campuscart-web:${WEB_TAG} \
                          --insecure \
                          --insecure-pull \
                          ${CACHE_FLAG} \
                          ${PUSH_FLAGS}
                    '''
                }

                container('kaniko-nginx') {
                    unstash 'source'
                    sh '''
                        PUSH_FLAGS=""
                        CACHE_FLAG="--cache=true"
                        if [ "${NGINX_EXISTS}" = "true" ]; then
                            if [ "${FORCE_BUILD}" = "true" ]; then
                                echo "FORCE_BUILD: building nginx ${NGINX_TAG} WITHOUT pushing (the tag already exists in the registry)"
                                PUSH_FLAGS="--no-push"
                                CACHE_FLAG="--cache=false"
                            else
                                echo "nginx image ${NGINX_TAG} is already in the registry, skipping its build"
                                exit 0
                            fi
                        fi
                        /kaniko/executor \
                          --context=dir://$(pwd)/app-source \
                          --dockerfile=$(pwd)/app-source/nginx/Dockerfile \
                          --destination=192.168.1.3:5000/campuscart-nginx:${NGINX_TAG} \
                          --insecure \
                          --insecure-pull \
                          ${CACHE_FLAG} \
                          ${PUSH_FLAGS}
                    '''
                }
            }
        }

        // Gate: the images that are about to be promoted must have no fixable HIGH/CRITICAL
        // vulnerabilities. Runs on every run that would promote, so a failed scan keeps blocking
        // that version (the image tag already exists, so the build is skipped on the next run).
        stage('Image Scan') {
            when {
                beforeAgent true
                expression { env.RUN_IMAGE_SCAN == 'true' }
            }
            agent {
                kubernetes {
                    yaml '''
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: trivy
    image: aquasec/trivy:0.76.1
    command: ["cat"]
    tty: true
    resources:
      requests:
        cpu: "200m"
        memory: "256Mi"
      limits:
        cpu: "1"
        memory: "1536Mi"
'''
                }
            }
            steps {
                container('trivy') {
                    sh '''
                        rc=0
                        for img in campuscart-web:${WEB_TAG} campuscart-nginx:${NGINX_TAG}; do
                            echo "=== scanning ${img} ==="
                            trivy image --insecure --ignore-unfixed --severity HIGH,CRITICAL --scanners vuln --exit-code 1 192.168.1.3:5000/${img} || rc=1
                        done
                        exit ${rc}
                    '''
                }
            }
        }

        // The only "deploy" step left: record the new tags in the config repo.
        // No cluster credentials are used anywhere in this pipeline.
        stage('Update Config Repo') {
            when {
                beforeAgent true
                expression { env.NEEDS_PROMOTION == 'true' }
            }
            agent {
                kubernetes {
                    yaml '''
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: git
    image: alpine/git:v2.54.0
    command: ["cat"]
    tty: true
    resources:
      requests:
        cpu: "50m"
        memory: "64Mi"
      limits:
        cpu: "200m"
        memory: "128Mi"
'''
                }
            }
            steps {
                container('git') {
                    withCredentials([sshUserPrivateKey(credentialsId: 'config-repo-write-key', keyFileVariable: 'SSH_KEY')]) {
                        sh '''
                            set -e
                            [ -n "${WEB_TAG}" ] && [ -n "${NGINX_TAG}" ] || { echo "WEB_TAG or NGINX_TAG is empty, refusing to update the config repo"; exit 1; }

                            export GIT_SSH_COMMAND="ssh -i ${SSH_KEY} -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=/tmp/known_hosts"
                            git config --global user.name "jenkins-ci"
                            git config --global user.email "jenkins-ci@campuscart.local"

                            BRANCH="promote-${WEB_TAG}-${NGINX_TAG}"

                            rm -rf /tmp/config
                            git clone --branch main git@github.com:bharathMoger18/campuscart-config.git /tmp/config
                            cd /tmp/config
                            git checkout -b "${BRANCH}"

                            F=overlays/production/kustomization.yaml
                            sed -i "/campuscart-web/{n;s/newTag: .*/newTag: ${WEB_TAG}/;}" ${F}
                            sed -i "/campuscart-nginx/{n;s/newTag: .*/newTag: ${NGINX_TAG}/;}" ${F}

                            grep -A1 "campuscart-web" ${F} | grep -q "newTag: ${WEB_TAG}" || { echo "web tag edit did not apply"; exit 1; }
                            grep -A1 "campuscart-nginx" ${F} | grep -q "newTag: ${NGINX_TAG}" || { echo "nginx tag edit did not apply"; exit 1; }

                            if git diff --quiet; then
                                echo "main already points at web ${WEB_TAG} / nginx ${NGINX_TAG}: nothing to promote"
                                exit 0
                            fi

                            git diff
                            git add ${F}
                            git commit -m "ci: promote web ${WEB_TAG}, nginx ${NGINX_TAG} (Jenkins build #${BUILD_NUMBER})"

                            pushed=false
                            for attempt in 1 2 3; do
                                if git push --force origin "HEAD:refs/heads/${BRANCH}"; then pushed=true; break; fi
                                echo "push failed (attempt ${attempt}), retrying in 5s"
                                sleep 5
                            done
                            [ "${pushed}" = "true" ] || { echo "could not push after 3 attempts"; exit 1; }

                            echo "================================================================"
                            echo "Promotion branch pushed: ${BRANCH}"
                            echo "Open the pull request, review it, and merge it to deploy:"
                            echo "https://github.com/bharathMoger18/campuscart-config/compare/main...${BRANCH}?expand=1"
                            echo "================================================================"
                        '''
                    }
                }
            }
        }
    }

    post {
        failure {
            script {
                try {
                    timeout(time: 3, unit: 'MINUTES') {
                        podTemplate(yaml: '''
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: curl
    image: alpine/k8s:1.30.14
    command: ["cat"]
    tty: true
    resources:
      requests:
        cpu: "50m"
        memory: "64Mi"
      limits:
        cpu: "200m"
        memory: "128Mi"
''') {
                            node(POD_LABEL) {
                                container('curl') {
                                    withCredentials([string(credentialsId: 'notify-webhook', variable: 'HOOK')]) {
                                        sh '''
                                            MSG="CampusCart (gitops) build #${BUILD_NUMBER} FAILED: ${BUILD_URL}"
                                            printf '{"text":"%s"}' "$MSG" > /tmp/payload.json
                                            curl -fsS -X POST -H 'Content-Type: application/json' --data @/tmp/payload.json "$HOOK"
                                        '''
                                    }
                                }
                            }
                        }
                    }
                } catch (err) {
                    echo "Failure notification skipped: ${err.message}"
                }
            }
        }
    }
}
