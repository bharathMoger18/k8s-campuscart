// Jenkinsfile.security
// A SEPARATE Jenkins job (Pipeline script from SCM, script path Jenkinsfile.security) that runs
// weekly. The per-build Security Scan only runs when the web image is rebuilt, so manifest-only
// commits and base-image patches slip past it; this job covers both.
// The image scan reads the images that are ACTUALLY running in the cluster (no :latest).
pipeline {
    agent none
    triggers {
        // Sundays around 11:00 (Jenkins picks the minute). The Jenkins controller must be running then.
        cron('H 11 * * 0')
    }
    options {
        timeout(time: 30, unit: 'MINUTES')
    }
    stages {
        stage('Dependency audit') {
            agent {
                kubernetes {
                    yaml '''
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: python
    image: python:3.12-slim
    command: ["cat"]
    tty: true
    resources:
      requests:
        cpu: "100m"
        memory: "256Mi"
      limits:
        cpu: "500m"
        memory: "512Mi"
'''
                }
            }
            steps {
                container('python') {
                    sh '''
                        pip install --no-cache-dir -q pip-audit
                        pip-audit -r campuscart-backend/requirements.txt --no-deps --disable-pip
                    '''
                }
            }
        }
        stage('Image scan') {
            agent {
                kubernetes {
                    yaml '''
apiVersion: v1
kind: Pod
spec:
  serviceAccountName: jenkins-deployer
  containers:
  - name: kubectl
    image: alpine/k8s:1.29.15
    command: ["cat"]
    tty: true
    resources:
      requests:
        cpu: "50m"
        memory: "64Mi"
      limits:
        cpu: "200m"
        memory: "128Mi"
  - name: trivy
    image: aquasec/trivy:latest
    command: ["cat"]
    tty: true
    resources:
      requests:
        cpu: "200m"
        memory: "256Mi"
      limits:
        cpu: "1"
        memory: "1536Mi"
'''
                }
            }
            steps {
                // Step 1: ask the cluster which images are really deployed (web + nginx, one per line).
                container('kubectl') {
                    sh '''
                        kubectl get deployment web nginx -n k8s-campuscart \
                          -o jsonpath='{range .items[*]}{range .spec.template.spec.containers[*]}{.image}{"\\n"}{end}{end}' \
                          | sort -u > images.txt
                        echo "Images running in the cluster:"
                        cat images.txt
                        [ -s images.txt ] || { echo "no images found in the cluster, refusing to report a clean scan"; exit 1; }
                    '''
                }
                // Step 2: scan each of them. The workspace is shared between the two containers.
                container('trivy') {
                    sh '''
                        rc=0
                        while read -r img; do
                            [ -n "${img}" ] || continue
                            echo "=== scanning ${img} ==="
                            trivy image --insecure --ignore-unfixed --severity HIGH,CRITICAL --scanners vuln --exit-code 1 "${img}" || rc=1
                        done < images.txt
                        exit ${rc}
                    '''
                }
            }
        }
    }
    post {
        failure {
            script {
                try {
                    timeout(time: 3, unit: 'MINUTES') {
                        podTemplate(yaml: '''
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: curl
    image: alpine/k8s:1.29.15
    command: ["cat"]
    tty: true
    resources:
      requests:
        cpu: "50m"
        memory: "64Mi"
      limits:
        cpu: "200m"
        memory: "128Mi"
''') {
                            node(POD_LABEL) {
                                container('curl') {
                                    withCredentials([string(credentialsId: 'notify-webhook', variable: 'HOOK')]) {
                                        sh '''
                                            MSG="CampusCart weekly security job FAILED: ${BUILD_URL}"
                                            printf '{"text":"%s"}' "$MSG" > /tmp/payload.json
                                            curl -fsS -X POST -H 'Content-Type: application/json' --data @/tmp/payload.json "$HOOK"
                                        '''
                                    }
                                }
                            }
                        }
                    }
                } catch (err) {
                    echo "Failure notification skipped: ${err.message}"
                }
            }
        }
    }
}
