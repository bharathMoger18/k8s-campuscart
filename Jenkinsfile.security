// Jenkinsfile.security
// A SEPARATE Jenkins job (Pipeline script from SCM, script path Jenkinsfile.security) that runs
// weekly. The per-build Security Scan only runs when the web image is rebuilt, so manifest-only
// commits and base-image patches slip past it; this job covers both.
pipeline {
    agent none
    triggers {
        // Sundays around 11:00 (Jenkins picks the minute). The Jenkins controller must be running then.
        cron('H 11 * * 0')
    }
    options {
        timeout(time: 30, unit: 'MINUTES')
    }
    stages {
        stage('Dependency audit') {
            agent {
                kubernetes {
                    yaml '''
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: python
    image: python:3.12-slim
    command: ["cat"]
    tty: true
    resources:
      requests:
        cpu: "100m"
        memory: "256Mi"
      limits:
        cpu: "500m"
        memory: "512Mi"
'''
                }
            }
            steps {
                container('python') {
                    sh '''
                        pip install --no-cache-dir -q pip-audit
                        pip-audit -r campuscart-backend/requirements.txt --no-deps --disable-pip
                    '''
                }
            }
        }
        stage('Image scan') {
            agent {
                kubernetes {
                    yaml '''
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: trivy
    image: aquasec/trivy:latest
    command: ["cat"]
    tty: true
    resources:
      requests:
        cpu: "200m"
        memory: "256Mi"
      limits:
        cpu: "1"
        memory: "1536Mi"
'''
                }
            }
            steps {
                container('trivy') {
                    sh '''
                        rc=0
                        trivy image --insecure --ignore-unfixed --severity HIGH,CRITICAL --scanners vuln --exit-code 1 192.168.1.3:5000/campuscart-web:latest || rc=1
                        trivy image --insecure --ignore-unfixed --severity HIGH,CRITICAL --scanners vuln --exit-code 1 192.168.1.3:5000/campuscart-nginx:latest || rc=1
                        exit $rc
                    '''
                }
            }
        }
    }
    post {
        failure {
            script {
                try {
                    timeout(time: 3, unit: 'MINUTES') {
                        podTemplate(yaml: '''
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: curl
    image: alpine/k8s:1.29.15
    command: ["cat"]
    tty: true
    resources:
      requests:
        cpu: "50m"
        memory: "64Mi"
      limits:
        cpu: "200m"
        memory: "128Mi"
''') {
                            node(POD_LABEL) {
                                container('curl') {
                                    withCredentials([string(credentialsId: 'notify-webhook', variable: 'HOOK')]) {
                                        sh '''
                                            MSG="CampusCart weekly security job FAILED: ${BUILD_URL}"
                                            printf '{"text":"%s"}' "$MSG" > /tmp/payload.json
                                            curl -fsS -X POST -H 'Content-Type: application/json' --data @/tmp/payload.json "$HOOK"
                                        '''
                                    }
                                }
                            }
                        }
                    }
                } catch (err) {
                    echo "Failure notification skipped: ${err.message}"
                }
            }
        }
    }
}
