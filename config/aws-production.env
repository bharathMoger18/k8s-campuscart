# Non-secret endpoints for the EKS app pipeline (Jenkinsfile.aws). Read by scripts/ci/render-from-config.sh.
# After a Terraform apply (Jenkinsfile.terraform prints the outputs), paste the real values here and commit.
# RDS_ENDPOINT may include ":5432"; render-manifests.sh strips it. No secrets belong in this file.
# The REPLACE_* placeholders make the render step fail on purpose until you fill them in.
RDS_ENDPOINT=REPLACE_WITH_RDS_ENDPOINT_FROM_TERRAFORM_OUTPUT
REDIS_ENDPOINT=REPLACE_WITH_REDIS_ENDPOINT_FROM_TERRAFORM_OUTPUT
